#!/usr/bin/env bash
#
# dragonvent — compatibility helper for backing up, restoring, and installing
#             Panda Control Vent firmware on a BIGTREETECH Panda Vent.
#
# Usage:
#   dragonvent backup  [-p PORT] [-o FILE]                  # USB dump of stock (your way back)
#   dragonvent restore [-p PORT] FILE                       # USB flash a stock backup
#   dragonvent install [-H HOST] [TAG | FILE.bin]           # OTA over stock (no USB) — DEFAULT
#   dragonvent install --usb [-p PORT] FILE.bin             # USB recovery image
#   dragonvent help
#
# Examples:
#   dragonvent backup                                       # → stock-panda-vent-backup-<ts>.bin
#   dragonvent install v0.1.0-rc.10 -H 10.0.0.42            # OTA over stock
#   dragonvent install --usb stock-panda-vent-backup.bin    # USB recovery flash
#   dragonvent restore my-backup.bin
#
# install (OTA) needs `curl`; backup/restore/--usb need `esptool`
# (`pip install esptool`). GitHub download uses `gh` if present, else `curl`.

set -euo pipefail

REPO="${PANDA_CONTROL_VENT_REPO:-rdcstout/panda-control-vent}"
CHIP="esp32"
BAUD="460800"
FLASH_SIZE_BYTES=4194304   # 4 MB — matches the Panda Vent module

die() { echo "dragonvent: $*" >&2; exit 1; }

require_esptool() {
    if command -v esptool >/dev/null 2>&1; then ESPTOOL=(esptool); return
    elif command -v esptool.py >/dev/null 2>&1; then ESPTOOL=(esptool.py); return
    elif command -v python3 >/dev/null 2>&1 && python3 -c "import esptool" 2>/dev/null; then
        ESPTOOL=(python3 -m esptool)
        return
    fi
    # Not on PATH and not importable — check for common venv layouts so we can
    # give a specific "activate this" hint instead of a generic "install it".
    local candidate
    for candidate in ./bin/activate ./venv/bin/activate ./.venv/bin/activate \
                     ../venv/bin/activate ../.venv/bin/activate; do
        if [ -f "$candidate" ]; then
            die "esptool not found on PATH. A venv is nearby — try:
  source $candidate
then re-run this command."
        fi
    done
    die "esptool not found. Install with one of:
  python3 -m pip install --user esptool           # user-wide
  python3 -m venv .venv && source .venv/bin/activate && pip install esptool
On Debian/Raspberry Pi OS, --user pip may be blocked (PEP 668); use the venv path."
}

# Best-effort port autodetect: pick the first tty.usbserial* / ttyUSB* / ttyACM*.
autodetect_port() {
    local p
    for p in /dev/tty.usbserial-* /dev/ttyUSB* /dev/ttyACM*; do
        [ -e "$p" ] && { echo "$p"; return 0; }
    done
    return 1
}

# ---------- subcommands ----------

cmd_backup() {
    local port="" output=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -p) port="$2"; shift 2 ;;
            -o) output="$2"; shift 2 ;;
            *)  die "unknown arg: $1" ;;
        esac
    done
    [ -n "$port" ] || port="$(autodetect_port || die "no serial port found — pass -p /dev/tty.usbserial-XXXX")"
    [ -n "$output" ] || output="stock-panda-vent-backup-$(date +%Y%m%d-%H%M%S).bin"

    echo "→ dumping ${FLASH_SIZE_BYTES} bytes from $port to $output"
    "${ESPTOOL[@]}" --chip "$CHIP" -p "$port" -b "$BAUD" \
        read_flash 0x0 "$FLASH_SIZE_BYTES" "$output"
    echo "✓ backup saved: $output"
    echo "  keep this file safe — it's your only way back to stock firmware."
}

cmd_restore() {
    local port="" file=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -p) port="$2"; shift 2 ;;
            -*) die "unknown arg: $1" ;;
            *)  file="$1"; shift ;;
        esac
    done
    [ -n "$file" ] || die "usage: dragonvent restore [-p PORT] FILE"
    [ -f "$file" ] || die "not a file: $file"
    [ -n "$port" ] || port="$(autodetect_port || die "no serial port found — pass -p /dev/tty.usbserial-XXXX")"

    echo "→ restoring $file to $port"
    "${ESPTOOL[@]}" --chip "$CHIP" -p "$port" -b "$BAUD" \
        write_flash 0x0 "$file"
    echo "✓ restore complete"
}

# Download a release asset. Prefers `gh` if available for auth/rate-limit
# reasons; falls back to curl for anonymous fetch.
# download_release TAG OUT — downloads the application-only OTA image.
download_release() {
    local tag="$1" out="$2"
    # Release assets are versioned (no "latest" in the name), so resolve the real
    # tag first. gh can; without it, ask the user for a concrete tag.
    if [ "$tag" = "latest" ]; then
        command -v gh >/dev/null 2>&1 || die "pass a specific tag (e.g. v0.5.0) when the gh CLI isn't installed"
        tag="$(gh release view --repo "$REPO" --json tagName -q .tagName 2>/dev/null)" \
            || die "couldn't resolve the latest release"
    fi
    local primary="Panda-Control-Vent-${tag#v}-OTA.bin"
    if command -v gh >/dev/null 2>&1; then
        gh release download "$tag" --repo "$REPO" \
            --pattern "$primary" --output "$out" --clobber 2>/dev/null && return 0
        die "download failed — no $primary in release $tag"
    else
        local url="https://github.com/$REPO/releases/download/$tag/$primary"
        echo "→ downloading $primary"
        curl -fSL "$url" -o "$out" 2>/dev/null && return 0
        die "download failed — check the tag/variant or network"
    fi
}

cmd_install() {
    local port="" host="" tag="" file="" usb=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -p) port="$2"; usb=1; shift 2 ;;
            -H) host="$2"; shift 2 ;;
            -t) tag="$2"; shift 2 ;;
            -f) file="$2"; shift 2 ;;
            --usb) usb=1; shift ;;
            v[0-9]*|latest)
                [ -z "$tag" ] || die "tag specified twice ($tag and $1)"
                tag="$1"; shift ;;
            *.bin)
                [ -z "$file" ] || die "file specified twice ($file and $1)"
                file="$1"; shift ;;
            *)  die "unknown arg: $1" ;;
        esac
    done

    if [ -n "$usb" ]; then
        # ---- USB recovery: full-flash an explicitly supplied recovery image ----
        require_esptool
        [ -n "$port" ] || port="$(autodetect_port || die "no serial port found — pass -p /dev/ttyUSB0")"
        [ -n "$file" ] || die "USB recovery requires an explicit stock backup or official full-flash BIN"
        [ -f "$file" ] || die "not a file: $file"
        local image="$file"
        echo "→ USB full-flash ($image) on $port"
        "${ESPTOOL[@]}" --chip "$CHIP" -p "$port" -b "$BAUD" write_flash 0x0 "$image"
        echo "✓ recovery image written."
    else
        # ---- OTA over stock (default): upload the app to the device's /ota ----
        # Works against a Panda Vent running stock BTT firmware (and matches its
        # web-UI firmware upload). The stock bootloader + table are kept; only the
        # app slot is written.
        command -v curl >/dev/null 2>&1 || die "curl is required for OTA install (or use -p PORT for USB)"
        [ -n "$host" ] || host="PandaVent.local"
        local image
        if [ -n "$file" ]; then [ -f "$file" ] || die "not a file: $file"; image="$file"
        else [ -n "$tag" ] || tag="latest"; image="$(mktemp -t panda-control-vent-ota.XXXXXX.bin)"
             trap 'rm -f "${image:-}"' EXIT; download_release "$tag" "$image"; fi
        echo "→ OTA over stock: uploading $(basename "$image") to http://$host/ota"
        local code
        code="$(curl -s -m 180 -o /dev/null -w '%{http_code}' -X POST \
            -H 'Content-Type: application/octet-stream' -H 'OTA-Type: ota_fw' \
            --data-binary @"$image" "http://$host/ota")" \
            || die "upload failed — is the device reachable at http://$host/ ?"
        [ "$code" = "200" ] || die "device returned HTTP $code (expected 200 — is $host on stock firmware?)"
        echo "✓ uploaded — the device is rebooting into Panda Control Vent."
    fi
    echo "  if setup is required, join the 'Panda_Control_Vent_XXXX' network;"
    echo "  join it to set WiFi + printer source in the captive portal."
}

cmd_help() {
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
}

# ---------- dispatch ----------

sub="${1:-help}"
shift || true

case "$sub" in
    backup)  require_esptool; cmd_backup  "$@" ;;
    restore) require_esptool; cmd_restore "$@" ;;
    install) cmd_install "$@" ;;
    help|-h|--help) cmd_help ;;
    *) die "unknown subcommand: $sub (try 'dragonvent help')" ;;
esac
